AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
# RESTful API credentials (Agora console -> RESTful API). Required for the
# Conversational AI control API when Token007 auth is rejected with
# "401 Invalid token". When both are set the server uses HTTP Basic auth.
AGORA_CUSTOMER_ID=your_agora_customer_id
AGORA_CUSTOMER_SECRET=your_agora_customer_secret
# Spoken self-introduction the agent says right after joining the channel.
# Leave unset to use the default "Hi，我是 StackChan"; set empty to disable.
AGENT_GREETING=
XZ_DEVICE_TOKEN=change-me-before-deploying
PORT=8000
# How the dance is triggered. Comma-separated set of modes (enable either or both):
#   keyword  the server matches dance phrases in the user transcript. Local-friendly,
#            no public endpoint needed. (default)
#   mcp      the cloud ConvoAI agent decides to call the `dance` tool. Requires
#            XZ_DANCE_MCP_URL below. Use "keyword,mcp" for both, or "mcp" for MCP-only.
XZ_DANCE_TRIGGER=keyword
# Endpoint of THIS server's dance MCP, as reachable by Agora's cloud. Required when the
# "mcp" mode is enabled above (e.g. https://your-public-host/dance-mcp/mcp).
XZ_DANCE_MCP_URL=
# Optional: lock the dance MCP endpoint to specific Host headers (comma-separated).
# Leave unset to accept any host (DNS-rebinding protection off).
XZ_DANCE_MCP_ALLOWED_HOSTS=
