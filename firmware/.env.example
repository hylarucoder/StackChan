# Local firmware bridge settings. Copy to .env and fill with deployment values.
# The real .env file is ignored by git.

# XiaoZhi protocol bridge endpoints served by ./agora-server.
# Example:
# STACKCHAN_XIAOZHI_WS_URL=ws://192.168.1.12:8000/ws
# STACKCHAN_XIAOZHI_OTA_URL=http://192.168.1.12:8000/xiaozhi/ota/
STACKCHAN_XIAOZHI_WS_URL=
STACKCHAN_XIAOZHI_OTA_URL=

# Optional shortcut: when both values are set, firmware seeds these credentials
# into the existing StackChan Wi-Fi credential store before XiaoZhi starts.
STACKCHAN_WIFI_SSID=
STACKCHAN_WIFI_PASSWORD=
